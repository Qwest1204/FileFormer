    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def write_hex_to_file(filename, hex_data):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Создаёт файл с указанным именем и записывает в него данные из списка hex-значений.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    :param filename: str - Имя файла для создания/записи.\\n\",\n",
    "    \"    :param hex_data: list - Список hex-данных (может быть списком строк вроде ['01', '02'] или целых чисел [1, 2]).\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Если элементы списка - строки, преобразуем их в байты\\n\",\n",
    "    \"    if hex_data and isinstance(hex_data[0], str):\\n\",\n",
    "    \"        # Предполагаем, что строки - это hex без '0x', например '1a'\\n\",\n",
    "    \"        byte_data = bytes.fromhex(' '.join(hex_data))\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        # Если это список целых чисел (байтов), преобразуем напрямую\\n\",\n",
    "    \"        byte_data = bytes(hex_data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with open(filename, 'wb') as file:\\n\",\n",
    "    \"        file.write(byte_data)\"\n",
    "   ],\n",
